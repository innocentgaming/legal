# CLARITY — AI Legal Co-Pilot Environment Configuration

# Server Config
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# Security & JWT Token Config
JWT_SECRET=your-secure-random-jwt-secret-key-min-32-chars

# LLM Provider Configuration
# Set your Gemini API key (recommended: get from https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: OpenAI API Key
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Max Upload Limits
MAX_FILE_SIZE_MB=25
